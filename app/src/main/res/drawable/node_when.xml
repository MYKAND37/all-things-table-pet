<?xml version="1.0" encoding="utf-8"?>
<!--
  One node of a rule's flow: 当 → 如果 → 就. The three roles are told apart by colour alone,
  so the shape has to stay identical or the diagram stops reading as one chain.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#12FFFFFF" />
    <stroke
        android:width="1dp"
        android:color="#FF6C4CE0" />
    <corners android:radius="10dp" />
</shape>
