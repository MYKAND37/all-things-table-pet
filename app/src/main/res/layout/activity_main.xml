<?xml version="1.0" encoding="utf-8"?>
<!--
  The shell: a fixed rail of four areas on the left, a frosted pane on the right.
  No behaviour lives here yet.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_aurora"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- ── 侧栏 ─────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/sidebar"
            android:layout_width="128dp"
            android:layout_height="match_parent"
            android:background="@drawable/glass_sidebar"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingTop="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="12dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_pet_mark"
                    app:tint="@color/brand" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/app_name"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/menuSandbox"
                style="@style/MenuItem"
                android:text="@string/menu_sandbox" />

            <TextView
                android:id="@+id/menuPets"
                style="@style/MenuItem"
                android:text="@string/menu_pets" />

            <TextView
                android:id="@+id/menuProps"
                style="@style/MenuItem"
                android:text="@string/menu_props" />

            <TextView
                android:id="@+id/menuLogic"
                style="@style/MenuItem"
                android:text="@string/menu_logic" />
        </LinearLayout>

        <!-- ── 内容区（磨砂） ───────────────────────── -->
        <FrameLayout
            android:id="@+id/content"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:background="@drawable/glass_panel">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:alpha="0.18"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_pet_mark"
                    app:tint="@color/brand" />

                <TextView
                    android:id="@+id/contentTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/menu_sandbox"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/contentHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/content_placeholder"
                    android:textColor="@color/text_subtle"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
