<?xml version="1.0" encoding="utf-8"?>
<!--
  The shell: a rail of four areas on the left, a frosted pane on the right.

    测试场    runs a character: pick one from the chips, then drag it around
    桌宠管理  a folder of packages; open one to import artwork for its bones

  The rail collapses so the test bench gets the whole width.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_aurora"
    android:fitsSystemWindows="true">

    <!--
        用户自己的背景图（1.20.0）。铺在自带极光**之上**、所有面板**之下** —— 面板是半透明
        白的，所以图会透过来一点，这就是"主题"的全部实现：没有第二套配色，只是底下换了张画。
        没有设背景图时这一层是 GONE，自带极光就从根布局的 background 里露出来。
    -->
    <ImageView
        android:id="@+id/themeBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- 压暗那一层：亮照片上白字会糊，alpha 由「浓淡」定。0 的时候它等于不存在。 -->
    <View
        android:id="@+id/themeScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#00000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="10dp">

        <!-- ── 侧栏 ─────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/sidebar"
            android:layout_width="128dp"
            android:layout_height="match_parent"
            android:background="@drawable/glass_sidebar"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:id="@+id/railHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingTop="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_pet_mark"
                    app:tint="@color/brand" />

                <TextView
                    android:id="@+id/railHint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/rail_collapse"
                    android:textColor="@color/text_subtle"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/menuSandbox"
                style="@style/MenuItem"
                android:text="@string/menu_sandbox" />

            <TextView
                android:id="@+id/menuPets"
                style="@style/MenuItem"
                android:text="@string/menu_pets" />

            <TextView
                android:id="@+id/menuProps"
                style="@style/MenuItem"
                android:text="@string/menu_props" />

            <TextView
                android:id="@+id/menuLogic"
                style="@style/MenuItem"
                android:text="@string/menu_logic" />

            <TextView
                android:id="@+id/menuLiquids"
                style="@style/MenuItem"
                android:text="@string/menu_liquids" />

            <TextView
                android:id="@+id/menuParticles"
                style="@style/MenuItem"
                android:text="@string/menu_particles" />

            <TextView
                android:id="@+id/menuAnims"
                style="@style/MenuItem"
                android:text="@string/menu_anims" />

            <TextView
                android:id="@+id/menuSettings"
                style="@style/MenuItem"
                android:text="@string/menu_settings" />

            <!-- 召唤到桌面：侧栏最下面，和上面那些"页面"分开 —— 它不是一个页面。 -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/petSummon"
                style="@style/SummonButton"
                android:text="@string/pet_summon" />
        </LinearLayout>

        <!-- ── 内容区（磨砂） ───────────────────────── -->
        <FrameLayout
            android:id="@+id/content"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/glass_panel">

            <!-- 道具管理 / 逻辑管理 还没做 -->
            <LinearLayout
                android:id="@+id/placeholder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:alpha="0.18"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_pet_mark"
                    app:tint="@color/brand" />

                <TextView
                    android:id="@+id/contentTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/menu_sandbox"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/contentHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/content_placeholder"
                    android:textColor="@color/text_subtle"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- ── 测试场 ───────────────────────────── -->
            <FrameLayout
                android:id="@+id/sandboxPane"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <dev.atp.pet.ui.PhysicsSandboxView
                    android:id="@+id/sandboxView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:paddingStart="8dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/petChooser"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </FrameLayout>

            <!-- ── 桌宠管理：桌宠列表 ───────────────── -->
            <ScrollView
                android:id="@+id/petListScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/petList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp" />
            </ScrollView>

            <!-- ── 桌宠管理：某只桌宠的部位 ─────────── -->
            <ScrollView
                android:id="@+id/partListScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/partList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp" />
            </ScrollView>

            <!-- ── 桌宠管理：一个部位的文件夹 ───────── -->
            <ScrollView
                android:id="@+id/partFilesScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/partFilesList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp" />
            </ScrollView>

            <!-- ── 桌宠管理：图层深度 ───────────────── -->
            <ScrollView
                android:id="@+id/depthScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/depthList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp" />
            </ScrollView>

            <!-- ── 液体管理 ─────────────────────────── -->
            <ScrollView
                android:id="@+id/liquidScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/liquidList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp" />
            </ScrollView>

            <!-- ── 粒子管理 ─────────────────────────── -->
            <ScrollView
                android:id="@+id/particleScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/particleList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp" />
            </ScrollView>

            <!-- ── 动画管理：左边这一段和它的帧，右边是角色 ─────────── -->
            <!--
                右边能看见角色（1.22.0），因为"摆一帧"本来就是对着角色摆的：在左边改数字、
                跑到测试场看效果、再跑回来，那不是编辑动画，那是来回跑。
            -->
            <LinearLayout
                android:id="@+id/animRow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

              <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.85"
                    android:orientation="vertical">

                    <ScrollView
                        android:id="@+id/animScroll"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/animList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="10dp" />
                    </ScrollView>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.15"
                    android:orientation="vertical"
                    android:paddingStart="6dp">

                    <!-- 这一帧画哪几套图：开着的那几个就是预览里亮着的。 -->
                    <HorizontalScrollView
                        android:id="@+id/animStatesScroll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/animStates"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <dev.atp.pet.ui.SkeletonView
                        android:id="@+id/animView"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                </LinearLayout>
              </LinearLayout>

                <!--
                    时间轴（1.23.0）：标尺 + 播放头 + 一行一根骨头 + 一行"图"。
                    高度由"有几行"决定（TimelineView 自己量），所以这里只给一个上限 ——
                    一只手的时间轴不该和十九根骨头的一样高。
                -->
                <ScrollView
                    android:id="@+id/animTimelineScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxHeight="240dp"
                    android:background="@drawable/glass_panel"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:scrollbars="none">

                    <dev.atp.pet.ui.TimelineView
                        android:id="@+id/animTimeline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </ScrollView>
            </LinearLayout>

            <!-- ── 全局设置 ─────────────────────────── -->
            <ScrollView
                android:id="@+id/settingsScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/settingsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp" />
            </ScrollView>

            <!-- ── 道具管理 ─────────────────────────── -->
            <ScrollView
                android:id="@+id/propListScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/propList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp" />
            </ScrollView>

            <!-- ── 逻辑管理 ─────────────────────────── -->
            <LinearLayout
                android:id="@+id/logicPane"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- 图，以及浮在它右上角的文件夹那一行。

                     第一层是**文件夹**：每只桌宠一个，外加一个全局的「道具」（道具有自己的
                     文件，不属于任何一只）。它放在右上角，因为它回答的是"这是谁的东西"，
                     而这一页下面每一行都依赖这个答案；放在最下面一条横栏里的时候，
                     它和一排模块按钮长得一模一样。 -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <dev.atp.pet.ui.LogicGraphView
                        android:id="@+id/logicGraph"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <HorizontalScrollView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:paddingStart="8dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="8dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/logicFolderBar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>
                </FrameLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/logicBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp" />
                </HorizontalScrollView>

                <!-- 液体管理：在逻辑栏下面，因为液体是规则喷出来的东西，是逻辑的一部分。
                     但它是自己的一栏：液体有自己的名字、颜色和黏度，而且点一下就能喷出来
                     看效果，不用先写一条规则。 -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/liquidBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingTop="2dp"
                        android:paddingBottom="8dp" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- ── 桌宠管理：导入对齐 ───────────────── -->
            <FrameLayout
                android:id="@+id/alignPane"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <dev.atp.pet.ui.PartAlignView
                    android:id="@+id/alignView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/alignCancel"
                        style="@style/AlignButton"
                        android:text="@string/align_cancel" />

                    <TextView
                        android:id="@+id/alignCanvas"
                        style="@style/AlignButton"
                        android:text="@string/align_canvas" />

                    <TextView
                        android:id="@+id/alignBone"
                        style="@style/AlignButton"
                        android:text="@string/align_bone" />

                    <TextView
                        android:id="@+id/alignMinus"
                        style="@style/AlignButton"
                        android:text="@string/align_minus" />

                    <TextView
                        android:id="@+id/alignPlus"
                        style="@style/AlignButton"
                        android:text="@string/align_plus" />

                    <TextView
                        android:id="@+id/alignConfirm"
                        style="@style/AlignButton"
                        android:text="@string/align_confirm" />
                </LinearLayout>
            </FrameLayout>

            <!-- ── 桌宠管理：骨骼编辑器 ─────────────── -->
            <LinearLayout
                android:id="@+id/rigRow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:visibility="gone">

                <dev.atp.pet.ui.SkeletonView
                    android:id="@+id/skeletonView"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <!-- 骨骼选择栏。画布要留得下微调，所以它只有一列名字宽。 -->
                <ScrollView
                    android:id="@+id/rigBoneScroll"
                    android:layout_width="96dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/glass_panel"
                    android:padding="4dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/rigBonePanel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="4dp" />
                </ScrollView>
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/rigBarScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/rigBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/rigMode"
                        style="@style/AlignButton"
                        android:text="@string/rig_mode_pose" />

                    <TextView
                        android:id="@+id/rigAddBone"
                        style="@style/AlignButton"
                        android:text="@string/rig_add_bone" />

                    <TextView
                        android:id="@+id/rigAddNode"
                        style="@style/AlignButton"
                        android:text="@string/rig_add_node" />

                    <TextView
                        android:id="@+id/rigBoneList"
                        style="@style/AlignButton"
                        android:text="@string/rig_bone_list" />

                    <TextView
                        android:id="@+id/rigSaveBones"
                        style="@style/AlignButton"
                        android:text="@string/rig_save_bones" />

                    <TextView
                        android:id="@+id/rigReset"
                        style="@style/AlignButton"
                        android:text="@string/rig_reset" />

                    <TextView
                        android:id="@+id/rigSavePose"
                        style="@style/AlignButton"
                        android:text="@string/rig_save_pose" />

                    <TextView
                        android:id="@+id/rigReference"
                        style="@style/AlignButton"
                        android:text="@string/rig_reference" />

                    <TextView
                        android:id="@+id/rigResetBones"
                        style="@style/AlignButton"
                        android:text="@string/rig_reset_bones" />

                    <TextView
                        android:id="@+id/rigLimitMin"
                        style="@style/AlignButton"
                        android:text="@string/rig_limit_set_min" />

                    <TextView
                        android:id="@+id/rigLimitMax"
                        style="@style/AlignButton"
                        android:text="@string/rig_limit_set_max" />
                </LinearLayout>
            </HorizontalScrollView>

            <!--
                动画工作台的底下那条：都是"对这一帧做什么"。顺序照着做一帧的顺序排 ——
                先播看一遍、再把现在的样子存进这一帧、再调时长，最后才是加帧删帧。
            -->
            <HorizontalScrollView
                android:id="@+id/animBarScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/animBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:id="@+id/animPlay"
                        style="@style/AlignButton"
                        android:text="@string/anim_play" />

                    <TextView
                        android:id="@+id/animFrameAdd"
                        style="@style/AlignButton"
                        android:text="@string/anim_frame_add" />

                    <TextView
                        android:id="@+id/animSaveFrame"
                        style="@style/AlignButton"
                        android:text="@string/anim_save_frame" />

                    <TextView
                        android:id="@+id/animSlower"
                        style="@style/AlignButton"
                        android:text="@string/anim_frame_shorter" />

                    <TextView
                        android:id="@+id/animLonger"
                        style="@style/AlignButton"
                        android:text="@string/anim_frame_longer" />

                    <TextView
                        android:id="@+id/animDropFrame"
                        style="@style/AlignButton"
                        android:text="@string/anim_drop_frame" />

                    <TextView
                        android:id="@+id/animResetPose"
                        style="@style/AlignButton"
                        android:text="@string/anim_reset_pose" />

                    <!-- 时间轴（1.23.0）：打一个关键帧 / 删一个 / 换通道 / 把帧转成通道。 -->
                    <TextView
                        android:id="@+id/animKeyAdd"
                        style="@style/AlignButton"
                        android:text="@string/anim_key_add" />

                    <TextView
                        android:id="@+id/animKeyDrop"
                        style="@style/AlignButton"
                        android:text="@string/anim_key_drop" />

                    <TextView
                        android:id="@+id/animChannel"
                        style="@style/AlignButton"
                        android:text="@string/anim_channel_rot" />

                    <TextView
                        android:id="@+id/animBake"
                        style="@style/AlignButton"
                        android:text="@string/anim_bake" />

                    <TextView
                        android:id="@+id/animFit"
                        style="@style/AlignButton"
                        android:text="@string/anim_fit" />

                    <TextView
                        android:id="@+id/animBones"
                        style="@style/AlignButton"
                        android:text="@string/anim_bones" />

                    <TextView
                        android:id="@+id/animEditBones"
                        style="@style/AlignButton"
                        android:text="@string/anim_edit_bones" />

                    <TextView
                        android:id="@+id/animSaveBones"
                        style="@style/AlignButton"
                        android:text="@string/anim_save_bones" />

                    <TextView
                        android:id="@+id/animMeta"
                        style="@style/AlignButton"
                        android:text="@string/anim_meta" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/statusLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:padding="10dp"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>