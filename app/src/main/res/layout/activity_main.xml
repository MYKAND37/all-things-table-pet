<?xml version="1.0" encoding="utf-8"?>
<!--
  The shell: a rail of four areas on the left, a frosted pane on the right.

    测试场    runs a character: pick one from the chips, then drag it around
    桌宠管理  a folder of packages; open one to import artwork for its bones

  The rail collapses so the test bench gets the whole width.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_aurora"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="10dp">

        <!-- ── 侧栏 ─────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/sidebar"
            android:layout_width="128dp"
            android:layout_height="match_parent"
            android:background="@drawable/glass_sidebar"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:id="@+id/railHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingTop="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_pet_mark"
                    app:tint="@color/brand" />

                <TextView
                    android:id="@+id/railHint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/rail_collapse"
                    android:textColor="@color/text_subtle"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/menuSandbox"
                style="@style/MenuItem"
                android:text="@string/menu_sandbox" />

            <TextView
                android:id="@+id/menuPets"
                style="@style/MenuItem"
                android:text="@string/menu_pets" />

            <TextView
                android:id="@+id/menuProps"
                style="@style/MenuItem"
                android:text="@string/menu_props" />

            <TextView
                android:id="@+id/menuLogic"
                style="@style/MenuItem"
                android:text="@string/menu_logic" />
        </LinearLayout>

        <!-- ── 内容区（磨砂） ───────────────────────── -->
        <FrameLayout
            android:id="@+id/content"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/glass_panel">

            <!-- 道具管理 / 逻辑管理 还没做 -->
            <LinearLayout
                android:id="@+id/placeholder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:alpha="0.18"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_pet_mark"
                    app:tint="@color/brand" />

                <TextView
                    android:id="@+id/contentTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/menu_sandbox"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/contentHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/content_placeholder"
                    android:textColor="@color/text_subtle"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- ── 测试场 ───────────────────────────── -->
            <FrameLayout
                android:id="@+id/sandboxPane"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <dev.atp.pet.ui.PhysicsSandboxView
                    android:id="@+id/sandboxView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:paddingStart="8dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/petChooser"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </FrameLayout>

            <!-- ── 桌宠管理：桌宠列表 ───────────────── -->
            <ScrollView
                android:id="@+id/petListScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/petList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp" />
            </ScrollView>

            <!-- ── 桌宠管理：某只桌宠的部位 ─────────── -->
            <ScrollView
                android:id="@+id/partListScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/partList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp" />
            </ScrollView>

            <!-- ── 桌宠管理：图层深度 ───────────────── -->
            <ScrollView
                android:id="@+id/depthScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/depthList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp" />
            </ScrollView>

            <!-- ── 桌宠管理：导入对齐 ───────────────── -->
            <FrameLayout
                android:id="@+id/alignPane"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <dev.atp.pet.ui.PartAlignView
                    android:id="@+id/alignView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/alignCancel"
                        style="@style/AlignButton"
                        android:text="@string/align_cancel" />

                    <TextView
                        android:id="@+id/alignCanvas"
                        style="@style/AlignButton"
                        android:text="@string/align_canvas" />

                    <TextView
                        android:id="@+id/alignBone"
                        style="@style/AlignButton"
                        android:text="@string/align_bone" />

                    <TextView
                        android:id="@+id/alignMinus"
                        style="@style/AlignButton"
                        android:text="@string/align_minus" />

                    <TextView
                        android:id="@+id/alignPlus"
                        style="@style/AlignButton"
                        android:text="@string/align_plus" />

                    <TextView
                        android:id="@+id/alignConfirm"
                        style="@style/AlignButton"
                        android:text="@string/align_confirm" />
                </LinearLayout>
            </FrameLayout>

            <!-- ── 桌宠管理：骨骼编辑器 ─────────────── -->
            <dev.atp.pet.ui.SkeletonView
                android:id="@+id/skeletonView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <HorizontalScrollView
                android:id="@+id/rigBarScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/rigBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/rigMode"
                        style="@style/AlignButton"
                        android:text="@string/rig_mode_pose" />

                    <TextView
                        android:id="@+id/rigAddBone"
                        style="@style/AlignButton"
                        android:text="@string/rig_add_bone" />

                    <TextView
                        android:id="@+id/rigBoneList"
                        style="@style/AlignButton"
                        android:text="@string/rig_bone_list" />

                    <TextView
                        android:id="@+id/rigSaveBones"
                        style="@style/AlignButton"
                        android:text="@string/rig_save_bones" />

                    <TextView
                        android:id="@+id/rigReset"
                        style="@style/AlignButton"
                        android:text="@string/rig_reset" />

                    <TextView
                        android:id="@+id/rigSavePose"
                        style="@style/AlignButton"
                        android:text="@string/rig_save_pose" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/statusLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:padding="10dp"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>