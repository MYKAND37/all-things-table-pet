<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ATP" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>

        <!-- Edge to edge: the aurora background runs under both bars. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/bg_base</item>
        <item name="android:windowBackground">@drawable/bg_aurora</item>
    </style>
</resources>
