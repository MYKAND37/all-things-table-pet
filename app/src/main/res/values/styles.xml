<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- One sidebar entry. Sized for four Chinese characters on a phone-width rail. -->
    <style name="MenuItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/bg_menu_item</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/menu_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!--
        召唤到桌面：侧栏最下面那个按钮。长得和菜单项一样（继承它的外观），但**故意不叫
        MenuItem** —— 那一份名单是"页面"，而这是一个动作（把宠物送出去/收回来）。
        wiring_check 的 rail 检查比的是"布局里的 MenuItem 和 Kotlin 里 menuItems 一一对应"，
        一个动作混进那份名单会让它变成一条假的失败。
    -->
    <style name="SummonButton" parent="MenuItem" />

    <!-- One button in the import alignment bar. -->
    <style name="AlignButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:background">@drawable/menu_item_selected</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
