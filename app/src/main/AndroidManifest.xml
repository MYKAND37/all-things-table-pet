<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        召唤到桌面：一只浮在别的 App 上面的桌宠。SYSTEM_ALERT_WINDOW 是"显示在其他应用上层"，
        这一条只有用户能在系统设置里给（App 弹不了那个框，只能把他带到那一页）。

        前台服务是 Android 的规矩：一个这样的窗口只有在"有东西在明显运行"时才允许存在，
        所以它必须挂一条通知。类型写 specialUse —— 它确实不属于任何别的类别，而 Play 的
        规矩就是"说不清就老实说 specialUse 并写清楚干什么"。
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ATP">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ui.PetOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="A desktop pet the user summons and dismisses: it draws the character over other apps and runs its own rules until it is sent home." />
        </service>

        <!--
            导出诊断 的 CSV 在 getExternalFilesDir(null)/diag/ 下，那是本 App 的私有目录：
            别的 App 拿不到 file:// 的路径（现代 Android 直接抛 FileUriExposedException），
            所以只能由 FileProvider 发一个带临时读权限的 content:// URI 出去。authorities 用
            ${applicationId} 而不是写死包名，debug 带后缀时两边才会一致；file_paths.xml 只
            放出 diag/ 一个子目录，而不是整个外部私有目录。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
